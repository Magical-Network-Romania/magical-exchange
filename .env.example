# Shared defaults for local Docker Compose and Dokploy production.
# For local use: cp .env.example .env
# For Dokploy: copy the needed values into the Compose service Environment tab.

POSTGRES_DB=magical_exchange
POSTGRES_USER=magical_exchange
POSTGRES_PASSWORD=change_me_to_a_long_random_password

# Local-only host ports. WEB_PORT maps localhost:3000 to nginx inside the web container on port 80.
POSTGRES_PORT=5432
BACKEND_PORT=8080
WEB_PORT=3000
