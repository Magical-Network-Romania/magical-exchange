{
	"biome.configurationPath": "./biome.json",
	"biome.enabled": true,
	"biome.requireConfiguration": true,
	"biome.suggestInstallingGlobally": false,
	"editor.codeActionsOnSave": {
		"source.action.noDuplicateClasses.biome": "explicit",
		"source.action.useSortedProperties.biome": "explicit",
		"source.fixAll.biome": "explicit",
		"source.organizeImports.biome": "explicit"
	},
	"editor.formatOnSave": true,
	"[css]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[html]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[java]": {
		"editor.defaultFormatter": "redhat.java"
	},
	"[javascript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[json]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[jsonc]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescript]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"[typescriptreact]": {
		"editor.defaultFormatter": "biomejs.biome"
	},
	"java.configuration.updateBuildConfiguration": "interactive",
	"java.format.settings.profile": "MagicalExchange",
	"java.format.settings.url": "${workspaceFolder}/services/backend/config/formatter/eclipse-java-formatter.xml"
}
