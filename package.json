{
	"name": "magical-exchange",
	"private": true,
	"scripts": {
		"backend:verify": "mvn -f services/backend/pom.xml verify",
		"check": "bunx biome check .",
		"docker:up": "docker compose -f infra/compose.local.yml up --build",
		"format": "bunx biome format --write .",
		"web:build": "bun run --cwd apps/web build",
		"web:check": "bunx biome check apps/web",
		"web:start": "bun run --cwd apps/web start",
		"web:typecheck": "bun run --cwd apps/web typecheck"
	},
	"workspaces": ["apps/web"],
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@types/bun": "^1.3.14",
		"@types/node": "^25.8.0",
		"typescript": "^6.0.3"
	}
}
