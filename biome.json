{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"root": true,
	"files": {
		"includes": ["**", "!bun.lock", "!**/dist", "!**/node_modules"],
		"ignoreUnknown": true
	},
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"defaultBranch": "main"
	},
	"linter": {
		"enabled": true,
		"domains": {
			"project": "recommended",
			"types": "recommended"
		},
		"rules": {
			"recommended": true,
			"complexity": {
				"noImplicitCoercions": "warn",
				"noUselessCatchBinding": "warn",
				"noUselessStringConcat": "warn",
				"useWhile": "warn"
			},
			"correctness": {
				"noGlobalDirnameFilename": "error",
				"noProcessGlobal": "error",
				"useJsonImportAttributes": "warn",
				"useSingleJsDocAsterisk": "info"
			},
			"nursery": {
				"noEqualsToNull": "error",
				"noFloatingPromises": "error",
				"noImpliedEval": "warn",
				"noMisusedPromises": "warn",
				"noNestedPromises": "info",
				"noProto": "error",
				"noReturnAssign": "info",
				"noScriptUrl": "info",
				"noShadow": "error",
				"useExhaustiveSwitchCases": "warn",
				"noUnnecessaryTemplateExpression": "info"
			},
			"performance": {
				"noAwaitInLoops": "warn",
				"noDelete": "error",
				"noNamespaceImport": "info",
				"noReExportAll": "warn",
				"useTopLevelRegex": "warn"
			},
			"style": {
				"noCommonJs": "error",
				"noEnum": "error",
				"noExportedImports": "info",
				"noInferrableTypes": "info",
				"noNamespace": "warn",
				"noNegationElse": "info",
				"noNestedTernary": "info",
				"noParameterAssign": {
					"level": "warn",
					"options": {
						"propertyAssignment": "allow"
					}
				},
				"noParameterProperties": "warn",
				"noSubstr": "info",
				"noUnusedTemplateLiteral": "warn",
				"noUselessElse": "warn",
				"noYodaExpression": "info",
				"useAsConstAssertion": "info",
				"useAtIndex": "info",
				"useCollapsedElseIf": "info",
				"useCollapsedIf": "info",
				"useConsistentArrowReturn": "info",
				"useConsistentBuiltinInstantiation": "warn",
				"useConst": "warn",
				"useDefaultParameterLast": "warn",
				"useDefaultSwitchClause": "info",
				"useExplicitLengthCheck": "warn",
				"useGroupedAccessorPairs": "warn",
				"useNumberNamespace": "warn",
				"useReadonlyClassProperties": "info",
				"useShorthandAssign": "info",
				"useSingleVarDeclarator": "warn",
				"useThrowNewError": "info",
				"useTrimStartEnd": "info",
				"useUnifiedTypeSignatures": "warn"
			},
			"suspicious": {
				"noAlert": "warn",
				"noBitwiseOperators": "info",
				"noEmptyBlockStatements": "warn",
				"noEvolvingTypes": "error",
				"noImportCycles": "warn",
				"noUnassignedVariables": "info",
				"noUnusedExpressions": "info",
				"noVar": "error",
				"useAwait": "warn",
				"useErrorMessage": "warn"
			}
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"recommended": false,
			"source": {
				"noDuplicateClasses": "on",
				"organizeImports": "on",
				"useSortedAttributes": "off",
				"useSortedInterfaceMembers": "off",
				"useSortedKeys": "off",
				"useSortedProperties": "on"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"indentWidth": 4,
		"lineEnding": "crlf",
		"lineWidth": 140,
		"attributePosition": "multiline",
		"bracketSpacing": true,
		"expand": "auto",
		"trailingNewline": true,
		"useEditorconfig": true
	},
	"javascript": {
		"linter": {
			"enabled": true
		},
		"assist": {
			"enabled": true
		},
		"parser": {
			"unsafeParameterDecoratorsEnabled": false,
			"jsxEverywhere": false
		},
		"formatter": {
			"enabled": true,
			"indentStyle": "tab",
			"indentWidth": 4,
			"lineEnding": "crlf",
			"lineWidth": 140,
			"quoteStyle": "double",
			"quoteProperties": "asNeeded",
			"trailingCommas": "none",
			"semicolons": "always",
			"arrowParentheses": "always",
			"bracketSpacing": true,
			"expand": "auto",
			"operatorLinebreak": "after",
			"trailingNewline": true
		}
	},
	"json": {
		"linter": {
			"enabled": true
		},
		"assist": {
			"enabled": true
		},
		"parser": {
			"allowComments": true,
			"allowTrailingCommas": false
		},
		"formatter": {
			"enabled": true,
			"indentStyle": "tab",
			"indentWidth": 4,
			"lineEnding": "crlf",
			"lineWidth": 140,
			"trailingCommas": "none",
			"bracketSpacing": true,
			"expand": "auto",
			"trailingNewline": true
		}
	},
	"css": {
		"linter": {
			"enabled": true
		},
		"assist": {
			"enabled": true
		},
		"parser": {
			"cssModules": true,
			"tailwindDirectives": false
		},
		"formatter": {
			"enabled": true,
			"indentStyle": "tab",
			"indentWidth": 4,
			"lineEnding": "crlf",
			"lineWidth": 140,
			"quoteStyle": "double",
			"trailingNewline": true
		}
	},
	"html": {
		"linter": {
			"enabled": true
		},
		"assist": {
			"enabled": true
		},
		"parser": {
			"interpolation": true
		},
		"formatter": {
			"enabled": true,
			"indentStyle": "tab",
			"indentWidth": 4,
			"lineEnding": "crlf",
			"lineWidth": 140,
			"attributePosition": "multiline",
			"bracketSameLine": false,
			"whitespaceSensitivity": "css",
			"selfCloseVoidElements": "always",
			"trailingNewline": true
		}
	}
}
